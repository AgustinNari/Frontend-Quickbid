{
  "name": "FrontendQuickbid",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:win": "cd android && gradlew.bat app:installDebug -PreactNativeDevServerPort=8081",
    "android:device": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:8080 tcp:8080 && react-native run-android --no-packager",
    "android:public": "node scripts/development-command.js android public",
    "android:local": "node scripts/development-command.js android localReverse",
    "android:emulator": "node scripts/development-command.js android emulator",
    "reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:8080 tcp:8080",
    "reverse:metro": "adb reverse tcp:8081 tcp:8081",
    "reverse:local-backend": "adb reverse tcp:8080 tcp:8080",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "start:local": "node scripts/development-command.js start localReverse",
    "start:emulator": "node scripts/development-command.js start emulator",
    "start:public": "node scripts/development-command.js start public",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native/debugger-frontend": "^0.85.3",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.0",
    "@stomp/stompjs": "^7.3.0",
    "fast-text-encoding": "^1.0.6",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-image-picker": "^8.2.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.25.0",
    "react-native-svg": "^15.15.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.1.3",
    "@react-native-community/cli-platform-android": "^20.1.3",
    "@react-native-community/cli-platform-ios": "^20.1.3",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
